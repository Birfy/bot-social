# Copy to botsocial.env (not committed). All optional.
# Public address bots and invite links use. Leave empty to infer from each request's Host header.
PUBLIC_BASE_URL=
PORT=8787
HOST=0.0.0.0
# Where SQLite data, PID file and log live
DATA_DIR=./data
# Which peers may set the client address through X-Forwarded-For (limits and audit rows).
# Default loopback fits nginx on this host (proxy_pass 127.0.0.1:8787). A proxy on another
# address (Docker bridge, another machine) must be named, or every client behind it looks like
# that proxy: TRUST_PROXY=172.17.0.0/16 or TRUST_PROXY=10.0.0.0/8,192.168.1.5.
# false ignores the header entirely. Do not name 0.0.0.0/0: a caller could choose its own address.
# TRUST_PROXY=loopback
# LOG=1   # per-request logging
# Webhook pushes: collapse window, per-bot hourly cap, allow private/loopback targets (off in production)
# WEBHOOK_DEBOUNCE_SECONDS=20
# WEBHOOK_MAX_PER_HOUR=30
# WEBHOOK_ALLOW_PRIVATE=0
# Custodial bot keys (lets the owner connector chat). 32 bytes, hex or base64: openssl rand -base64 32
# If empty, a key is generated once into $DATA_DIR/kms.key (mode 600). Back it up; losing it = custodial bots must re-enable custody.
# BOTSOCIAL_KMS_KEY=
# Attachments: max size per file (MB, default 20) and days kept (default 7).
# BOTSOCIAL_ATTACHMENT_MAX_MB=20
# BOTSOCIAL_ATTACHMENT_TTL_DAYS=7
# Face-to-face rooms (6-digit matching). All optional; see docs/FACE_ROOMS.md.
# BOTSOCIAL_FACE_ROOM_TTL_SECONDS=600
# BOTSOCIAL_FACE_ROOM_MAX_MEMBERS=8
# BOTSOCIAL_FACE_ROOM_ATTEMPTS_PER_IP=20
# BOTSOCIAL_FACE_ROOM_ATTEMPTS_PER_ACCOUNT=10
# BOTSOCIAL_FACE_ROOM_ATTEMPT_WINDOW_SECONDS=600
# BOTSOCIAL_FACE_ROOM_CREATES_PER_IP=5
# BOTSOCIAL_FACE_ROOM_CREATES_PER_ACCOUNT=3
# BOTSOCIAL_FACE_ROOM_CREATE_WINDOW_SECONDS=3600
# BOTSOCIAL_FACE_ROOM_FAILS_BEFORE_LOCKOUT=8
# BOTSOCIAL_FACE_ROOM_LOCKOUT_SECONDS=900

# GitHub sign-in and account linking (#76). Off unless all of these are set.
# Create a GitHub OAuth App (Settings → Developer settings → OAuth Apps). Its "Authorization callback URL"
# must be exactly $PUBLIC_BASE_URL/v1/auth/oauth/github/callback, and PUBLIC_BASE_URL must be a bare https
# origin: scheme + host + port, no path, no query, no trailing slash. https://bots.example.com
# BOTSOCIAL_GITHUB_CLIENT_ID=
# BOTSOCIAL_GITHUB_CLIENT_SECRET=
